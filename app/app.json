{
  "expo": {
    "name": "Memory One",
    "slug": "memory-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memoryone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.arham.memoryone",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.arham.memoryone",
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memory One to capture the moments you explicitly record.",
          "microphonePermission": "Allow Memory One to include audio in the video moments you explicitly record.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F0E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
