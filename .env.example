APP_ENV=development
APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080
APP_HTTP_TRUSTED_PROXIES=
APP_DATABASE_URL=postgres://app_user:change-me@localhost:5432/ai_second_brain?sslmode=disable
APP_JWT_SECRET=change-me-use-at-least-32-random-characters
APP_JWT_ISSUER=ai-second-brain
APP_JWT_ACCESS_TOKEN_TTL=24h
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_LOG_LEVEL=info
APP_LOG_PRETTY=true

# Voice ingestion and durable worker
APP_VOICE_STORAGE_DIR=./data/audio
APP_VOICE_MAX_UPLOAD_MB=25
APP_VOICE_EPISODE_DURATION=30s
APP_VOICE_WORKER_ENABLED=true
APP_VOICE_WORKER_POLL_INTERVAL=1s
APP_VOICE_WORKER_CONCURRENCY=2
APP_VOICE_WORKER_MAX_ATTEMPTS=5

# Speech-to-text. Use "mock" for local development without external calls.
APP_STT_PROVIDER=openai
APP_STT_BASE_URL=https://api.openai.com/v1
APP_STT_API_KEY=
APP_STT_MODEL=gpt-4o-transcribe-diarize
APP_STT_LANGUAGE=
APP_STT_PROMPT=
APP_STT_TIMEOUT=2m

# Memograph. API key is used on supported data endpoints; JWT is used for
# create-full/getGraph and is also a fallback for data endpoints.
APP_MEMOGRAPH_BASE_URL=
APP_MEMOGRAPH_API_KEY=
APP_MEMOGRAPH_JWT=
APP_MEMOGRAPH_TIMEOUT=3m
