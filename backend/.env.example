APP_ENV=development
APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080
APP_HTTP_TRUSTED_PROXIES=
APP_DATABASE_URL=postgres://app_user:change-me@localhost:5432/ai_second_brain?sslmode=disable
APP_JWT_SECRET=change-me-use-at-least-32-random-characters
# Encrypts saved per-account model API keys. Keep this stable across deploys.
# It falls back to APP_JWT_SECRET when omitted.
APP_MODEL_CREDENTIAL_KEY=change-me-use-a-separate-32-char-secret
APP_JWT_ISSUER=ai-second-brain
APP_JWT_ACCESS_TOKEN_TTL=24h
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_LOG_LEVEL=info
APP_LOG_PRETTY=true

# Voice ingestion and durable worker
APP_VOICE_STORAGE_DIR=./data/audio
APP_VOICE_MAX_UPLOAD_MB=25
# Owner reference clips are retained here until explicitly deleted.
APP_VOICE_ENROLLMENT_STORAGE_DIR=./data/voice-enrollment
APP_VOICE_ENROLLMENT_MAX_UPLOAD_MB=10
APP_VOICE_ENROLLMENT_MIN_DURATION=2s
APP_VOICE_ENROLLMENT_MAX_DURATION=10s
APP_VOICE_FFPROBE_PATH=ffprobe
APP_VOICE_INSPECTION_TIMEOUT=15s
APP_VOICE_EPISODE_SILENCE_GAP=8s
APP_VOICE_EPISODE_MAX_DURATION=2m
APP_VOICE_WORKER_ENABLED=true
APP_VOICE_WORKER_POLL_INTERVAL=1s
APP_VOICE_WORKER_CONCURRENCY=2
APP_VOICE_WORKER_MAX_ATTEMPTS=5

# Video ingestion. FFmpeg is included in the production container.
APP_VIDEO_STORAGE_DIR=./data/video
APP_VIDEO_MAX_UPLOAD_MB=250
APP_VIDEO_EPISODE_DURATION=30s
APP_VIDEO_FRAME_INTERVAL=5s
APP_VIDEO_MAX_FRAMES=12
APP_VIDEO_FFMPEG_PATH=ffmpeg
APP_VIDEO_EXTRACTION_TIMEOUT=2m

# Server-default speech-to-text. Any non-mock provider must implement the
# OpenAI-compatible /audio/transcriptions contract at APP_STT_BASE_URL.
# Authenticated accounts can override provider, base URL, model, and API key in
# Settings without restarting the backend.
APP_STT_PROVIDER=openai
APP_STT_BASE_URL=https://api.openai.com/v1
APP_STT_API_KEY=
APP_STT_MODEL=gpt-4o-transcribe-diarize
APP_STT_LANGUAGE=
APP_STT_PROMPT=
APP_STT_TIMEOUT=2m

# Persistent speaker identification. "local" and "external" use the same
# versioned multipart /v1/embeddings contract. Keep the model ID unchanged once
# profiles have been created.
APP_SPEAKER_EMBEDDING_PROVIDER=disabled
APP_SPEAKER_EMBEDDING_BASE_URL=http://127.0.0.1:8091
APP_SPEAKER_EMBEDDING_API_KEY=
APP_SPEAKER_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
APP_SPEAKER_EMBEDDING_TIMEOUT=30s
APP_SPEAKER_MATCH_THRESHOLD=0.62
APP_SPEAKER_AMBIGUOUS_MARGIN=0.08
APP_SPEAKER_PROVISIONAL_TTL=720h
APP_SPEAKER_MIN_CLIP_DURATION=2s
APP_SPEAKER_MAX_CLIP_DURATION=10s

# Visual understanding. "mock" avoids external calls during local development.
# If APP_VISION_API_KEY is empty, OPENAI_API_KEY or APP_STT_API_KEY is reused.
APP_VISION_PROVIDER=openai
APP_VISION_BASE_URL=https://api.openai.com/v1
APP_VISION_API_KEY=
APP_VISION_MODEL=gpt-4.1-mini
APP_VISION_DETAIL=low
APP_VISION_TIMEOUT=2m

# Memograph. Every route uses the API key when configured and falls back to
# the JWT only when no API key is available.
APP_MEMOGRAPH_BASE_URL=
APP_MEMOGRAPH_API_KEY=
APP_MEMOGRAPH_JWT=
APP_MEMOGRAPH_TIMEOUT=3m
# Limit graph writes across both workers. Keep this at 1 for self-hosted
# Memograph deployments with a small PostgreSQL connection budget.
APP_MEMOGRAPH_MAX_CONCURRENT_WRITES=1
